---
layout: default
---
{% assign head_member = site.members | where: 'team_head', true | first %}

<div class="post home">
  <!-- Header: title, short intro, buttons and the group leader -->
  <section class="home-hero">
    <div class="home-hero-text">
      <h1 class="home-title">{{ page.hero_title | default: site.title }}</h1>
      <p class="home-subtitle">{{ page.subtitle }}</p>
      <div class="home-lead">{{ page.hero_lead | markdownify }}</div>
      {% if page.hero_buttons %}
        <div class="home-buttons">
          {% for button in page.hero_buttons %}
            <a
              class="home-btn{% if forloop.first %} home-btn-primary{% endif %}"
              href="{% if button.url contains '#' %}{{ button.url }}{% else %}{{ button.url | relative_url }}{% endif %}"
            >
              {{- button.label -}}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if head_member.profile %}
      <div class="home-leader">
        <a href="{{ head_member.url | relative_url }}">
          <img src="{{ head_member.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ head_member.profile.name }}">
        </a>
        <div class="home-leader-name">
          <a href="{{ head_member.url | relative_url }}">
            {%- assign prefix_titles = 'Prof,Dr' | split: ',' -%}
            {%- if prefix_titles contains head_member.profile.title -%}
              {{ head_member.profile.title }}
              {{ head_member.profile.name }}
            {%- elsif head_member.profile.title -%}
              {{ head_member.profile.name }}, {{ head_member.profile.title }}
            {%- else -%}
              {{ head_member.profile.name }}
            {%- endif -%}
          </a>
        </div>
        <div class="home-leader-role">{{ head_member.profile.role | default: head_member.profile.position }}</div>
        <div class="home-leader-icons">
          {% if head_member.profile.email %}
            <a href="mailto:{{ head_member.profile.email }}" title="Email"><i class="fas fa-envelope"></i></a>
          {% endif %}
          {% if head_member.profile.linkedin %}
            <a href="https://www.linkedin.com/in/{{ head_member.profile.linkedin }}/" target="_blank" rel="noopener" title="LinkedIn"
              ><i class="fab fa-linkedin"></i
            ></a>
          {% endif %}
          {% if head_member.profile.orcid %}
            <a href="https://orcid.org/{{ head_member.profile.orcid }}" target="_blank" rel="noopener" title="ORCID"><i class="ai ai-orcid"></i></a>
          {% endif %}
          {% if head_member.profile.googlescholar %}
            <a
              href="https://scholar.google.com/citations?user={{ head_member.profile.googlescholar }}"
              target="_blank"
              rel="noopener"
              title="Google Scholar"
              ><i class="ai ai-google-scholar"></i
            ></a>
          {% endif %}
          {% if head_member.profile.arxiv %}
            <a
              href="https://arxiv.org/search/cs?searchtype=author&query={{ head_member.profile.arxiv }}"
              target="_blank"
              rel="noopener"
              title="arXiv"
              ><i class="ai ai-arxiv"></i
            ></a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </section>

  <!-- Numbers -->
  {% assign partner_countries = site.data.collaboration | map: 'country' | compact | uniq %}
  <section class="home-stats">
    <div>
      <b>{% bibliography_count %}</b>
      <span>publications</span>
    </div>
    <div>
      <b>{{ site.data.theses.size }}</b>
      <span>supervised theses</span>
    </div>
    <div>
      <b>{{ site.projects.size }}</b>
      <span>research projects</span>
    </div>
    <div>
      <b>{{ partner_countries.size }}</b>
      <span>partner countries</span>
    </div>
    {% if page.stats.dasip_since %}
      <div>
        <b>{{ page.stats.dasip_since }}</b>
        <span>DASIP co-organisers since</span>
      </div>
    {% endif %}
  </section>

  <!-- About us: full description of the group (page content) -->
  <section class="home-section home-about" id="about">
    <h2 class="home-section-title">About us</h2>
    <div class="home-about-text">{{ content }}</div>
    {% if page.about_keywords %}
      <div class="home-about-keywords">
        {% for keyword in page.about_keywords %}
          <span>{{ keyword }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </section>

  <!-- Research areas -->
  {% if page.research_areas %}
    <section class="home-section" id="research">
      <h2 class="home-section-title">What we work on</h2>
      <div class="home-areas">
        {% for area in page.research_areas %}
          <div class="home-area">
            <span class="home-area-icon"><i class="{{ area.icon }}"></i></span>
            <h3>{{ area.title }}</h3>
            {% if area.subtitle %}
              <div class="home-area-subtitle">{{ area.subtitle }}</div>
            {% endif %}
            <p>{{ area.text }}</p>
            {% if area.link %}
              <a href="{{ area.link | relative_url }}">{{ area.link_label | default: 'More' }} &rarr;</a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <!-- News and featured publications -->
  <section class="home-section home-two">
    {% if site.data.news.size > 0 %}
      <div class="home-news">
        <h2 class="home-section-title"><i class="fa-regular fa-newspaper"></i> News</h2>
        <ul>
          {% for item in site.data.news limit: page.news_limit %}
            <li>
              <span class="home-news-date">{{ item.date | date: '%b %Y' }}</span>
              <span>
                <span class="home-news-tag home-news-tag-{{ item.tag | downcase }}">{{ item.tag }}</span>
                {% if item.url -%}
                  <a href="{% if item.url contains '://' %}{{ item.url }}{% else %}{{ item.url | relative_url }}{% endif %}">{{ item.text }}</a>
                {%- else -%}
                  {{ item.text }}
                {%- endif %}
              </span>
            </li>
          {% endfor %}
        </ul>
        <a class="home-more" href="{{ '/conferences/' | relative_url }}">Conferences &rarr;</a>
      </div>
    {% endif %}

    {% if page.selected_papers != false %}
      <div class="home-featured">
        <h2 class="home-section-title"><i class="fa-solid fa-star"></i> Featured publications</h2>
        <div class="publications">
          {% bibliography --template bib_compact --group_by none --query @*[selected=true]* --max 4 %}
        </div>
        <a class="home-more" href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
      </div>
    {% endif %}
  </section>

  <!-- Team -->
  {% if page.team_rows %}
    <section class="home-section">
      <h2 class="home-section-title"><a href="{{ '/team' | relative_url }}">Our team</a></h2>
      {% for row in page.team_rows %}
        {% assign row_members = site.members | where: 'team_frontpage', true | where_exp: 'm', 'row.groups contains m.group' | sort: 'vis_order' %}
        {% if row_members.size > 0 %}
          <div class="home-team-group">{{ row.title }}</div>
          <div class="home-team">
            {% for member in row_members %}
              <a class="home-member" href="{{ member.url | relative_url }}">
                <img src="{{ member.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ member.profile.name }}" loading="lazy">
                <span class="home-member-name">{{ member.profile.name }}</span>
                {% if member.profile.position %}
                  <span class="home-member-role">{{ member.profile.position }}</span>
                {% elsif member.group == 'PhD Students' %}
                  <span class="home-member-role">PhD Student</span>
                {% endif %}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    </section>
  {% endif %}

  <!-- Partners and funding: project funders and research partners -->
  {% assign project_logos = site.projects | map: 'img' | compact | uniq %}
  {% assign partners = site.data.collaboration | where_exp: 'p', 'p.id' %}
  <section class="home-section">
    <h2 class="home-section-title"><a href="{{ '/collaboration/' | relative_url }}">Partners &amp; funding</a></h2>
    <div class="home-logos">
      <div class="home-logos-track">
        {% for copy in (1..2) %}
          <div
            class="home-logos-set"
            {% if copy == 2 %}
              aria-hidden="true"
            {% endif %}
          >
            {% for logo in project_logos %}
              <a
                href="{{ '/projects/' | relative_url }}"
                {% if copy == 2 %}
                  tabindex="-1"
                {% endif %}
                ><img src="{{ logo | prepend: '/' | relative_url }}" alt="Project funding" loading="lazy"
              ></a>
            {% endfor %}
            {% for partner in partners %}
              {% if partner.logo %}
                <a
                  href="{{ partner.url }}"
                  target="_blank"
                  rel="noopener"
                  title="{{ partner.institution | default: partner.name }}"
                  {% if copy == 2 %}
                    tabindex="-1"
                  {% endif %}
                  ><img
                    src="{{ partner.logo | prepend: '/assets/img/collaboration/' | relative_url }}"
                    alt="{{ partner.institution | default: partner.name }}"
                    loading="lazy"
                ></a>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- Join us -->
  {% if page.join_us %}
    {%
      include cta_banner.liquid
      title=page.join_us.title
      text=page.join_us.text
      button=page.join_us.button
      url=page.join_us.url
      logo=page.join_us.logo
    %}
  {% endif %}
</div>
