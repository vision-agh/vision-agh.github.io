---
layout: default

---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.profile.name }}</h1>
  </header>
  <article>
    {% if page.profile %}
      <div class="profile cv-profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% if page.profile.href %}<a href="{{ page.profile.href | relative_url }}">{% endif %}
          <img
            class="img-fluid{% assign ext = page.profile.image | slice: -4, 4 %}{% if ext != '.svg' %} z-depth-1 rounded{% endif %}"
            src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
            alt="{{ page.profile.name }}"
          >
          {% if page.profile.href %}</a>{% endif %}
        {% endif %}
        {% if page.profile %}
          <div class="address">
            <p>
              {% if page.profile.href %}<a href="{{ page.profile.href | relative_url }}">{% endif %}
              <span class="name font-semibold">
                {%- assign prefix_titles = 'Prof,Dr' | split: ',' -%}
                {%- if prefix_titles contains page.profile.title -%}
                  {{ page.profile.title }}
                  {{ page.profile.name }}
                {%- elsif page.profile.title -%}
                  {{ page.profile.name }}, {{ page.profile.title }}
                {%- else -%}
                  {{ page.profile.name }}
                {%- endif -%}
              </span>
              {% if page.profile.href %}</a>{% endif %}
              {% if page.profile.position -%}
                <br>
                {{ page.profile.position -}}
              {%- endif %}
              {% if page.profile.role -%}
                <br>
                {{ page.profile.role -}}
              {%- endif %}
              {% if page.profile.email -%}
                <br>
                <a href="mailto:{{ page.profile.email }}"><i class="fas fa-envelope"></i> {{ page.profile.email }}</a>
              {%- endif %}
              {% if page.profile.phone -%}
                <br>
                <a href="tel:{{ page.profile.phone }}"><i class="fas fa-phone"></i> {{ page.profile.phone }}</a>
              {%- endif %}
              {% if page.profile.website -%}
                <br>
                <a href="{{ page.profile.website }}" target="_blank"
                  ><i
                    class="fas fa-globe"
                  ></i>
                  {{ page.profile.website -}}
                </a>
              {%- endif %}

              <div class="social-icons text-center">
                {% if page.profile.linkedin -%}
                  <a
                    href="https://www.linkedin.com/in/{{ page.profile.linkedin }}/"
                    target="_blank"
                    ><i class="fab fa-linkedin"></i
                  ></a>
                {%- endif %}
                {% if page.profile.orcid -%}
                  <a href="https://orcid.org/{{ page.profile.orcid }}" target="_blank"
                    ><i
                      class="ai ai-orcid ai-1x"
                    ></i>
                  </a>
                {%- endif %}
                {% if page.profile.researchgate -%}
                  <a
                    href="https://www.researchgate.net/profile/{{ page.profile.researchgate }}"
                    target="_blank"
                    ><i
                      class="ai ai-researchgate ai-1x"
                    ></i
                  ></a>
                {%- endif %}
                {% if page.profile.scopus -%}
                  <a
                    href="https://www.scopus.com/authid/detail.uri?authorId={{ page.profile.scopus }}"
                    target="_blank"
                    ><i
                      class="ai ai-scopus ai-1x"
                    ></i
                  ></a>
                {%- endif %}
                {% if page.profile.googlescholar -%}
                  <a
                    href="https://scholar.google.com/citations?user={{ page.profile.googlescholar }}"
                    target="_blank"
                    ><i
                      class="ai ai-google-scholar ai-1x"
                    ></i
                  ></a>
                {%- endif %}
                {% if page.profile.arxiv -%}
                  <a
                    href="https://arxiv.org/search/cs?searchtype=author&query={{ page.profile.arxiv }}"
                    target="_blank"
                    title="arXiv"
                    ><i
                      class="ai ai-arxiv ai-1x"
                    ></i
                  ></a>
                {%- endif %}
              </div>
            </p>
            <p class="post">{{ page.profile.address }}</p>
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix cv-intro">
      {{ content }}

      {% if page.interests %}
        {% assign keywords = page.interests | sort_natural %}
        <div class="cv-keywords">
          {% for kw in keywords %}
            <span>{{ kw }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% assign sections = 'experience,education,awards' | split: ',' %}
    {% for section in sections %}
      {% assign entries = page[section] %}
      {% if entries %}
        {% if section == 'awards' %}
          {% assign sorted_entries = entries | sort: 'date' | reverse %}
        {% else %}
          {% assign sorted_entries = entries | sort: 'start' | reverse %}
        {% endif %}
        <section class="cv-section">
          <h2 class="page-section-title has-count">
            {{ section | capitalize }}
            <span class="section-count">{{ entries.size }}</span>
          </h2>
          <ol class="cv-timeline">
            {% for item in sorted_entries %}
              <li class="cv-item">
                <span class="cv-item-icon">
                  {% if section == 'education' %}
                    <i class="fa-solid fa-graduation-cap"></i>
                  {% elsif section == 'experience' %}
                    <i class="fa-solid fa-briefcase"></i>
                  {% else %}
                    <i class="fa-solid fa-trophy"></i>
                  {% endif %}
                </span>
                <div class="cv-item-body">
                  <div class="cv-item-head">
                    <h3>
                      {% if section == 'education' %}
                        {{ item.degree }}
                      {% elsif section == 'experience' %}
                        {{ item.role }}
                      {% else %}
                        {{ item.title }}
                      {% endif %}
                    </h3>
                    <span class="cv-item-date">
                      <i class="fa-regular fa-calendar"></i>
                      {% if section == 'awards' -%}
                        {%- if item.date contains '-' -%}{{ item.date | date: '%-d %B %Y' }}{%- else -%}{{ item.date }}{%- endif -%}
                      {%- else -%}
                        {%- if item.start contains '-' -%}{{ item.start | date: '%B %Y' }}{%- else -%}{{ item.start }}{%- endif %}
                        –
                        {% if item.end -%}
                          {%- if item.end contains '-' -%}{{ item.end | date: '%B %Y' }}{%- else -%}{{ item.end }}{%- endif -%}
                        {%- else -%}
                          Present
                        {%- endif -%}
                      {%- endif %}
                    </span>
                  </div>
                  {% if item.institution %}
                    <div class="cv-item-org">{{ item.institution }}</div>
                  {% endif %}
                  {% if item.summary %}
                    <p class="cv-item-summary">{{ item.summary }}</p>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>
        </section>
      {% endif %}
    {% endfor %}

    {% if page.news %}
      <h2 id="news">News</h2>
      {% comment %} {% include news.html %} {% endcomment %}
    {% endif %}

    {% if page.selected_papers %}
      <h2 id="recent-publications">Recent Publications</h2>
      {% comment %} {% include selected_papers.html %} {% endcomment %}
    {% endif %}

    {% if page.projects %}
      <h2 id="projects" class="about-tiles">Projects</h2>
      {% comment %} {% include about_tiles.html items=site.projects %} {% endcomment %}
    {% endif %}

    {% if page.supports %}
      <h2 id="support" class="about-tiles">Support</h2>
      {% comment %} {% include about_tiles.html items=site.supports %} {% endcomment %}
    {% endif %}

    {% if page.publications %}
      <h2 id="publications" class="page-section-title">Publications</h2>
      <div class="publications">
        {% bibliography -f papers -q @*[{{page.publications}}]* %}
      </div>
    {% endif %}
  </article>
</div>
