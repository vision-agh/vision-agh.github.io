---
layout: page

---
{% assign phd_students = site.members | where: 'group', 'PhD Students' %}
{% capture team_stats -%}
  {{ site.members.size }}|members;{{ phd_students.size }}|PhD students;{{ site.data.alumni.size }}|alumni
{%- endcapture %}
{% include page_stats.liquid items=team_stats %}

{% assign groups = site.members | sort: 'group_rank' | map: 'group' | uniq %}
{% for group in groups %}
  {% if group != 'Principal Investigators' %}
    <h2 class="page-section-title">{{ group }}</h2>
  {% endif %}
  <p>
    {% assign members = site.members | sort: 'vis_order' | where: 'group', group %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4">
      {% for member in members %}
        <div class="col mb-4">
          <div class="card h-100 team-card">
            <a href="{{ member.url | relative_url }}">
              {% if member.profile.image %}
                {% assign profile_image_path = member.profile.image | prepend: 'assets/img/' %}
                {% if member.profile.image_circular %}
                  {% assign profile_image_class = 'card-img-top img-fluid z-depth-1 rounded-circle mx-auto' %}
                {% else %}
                  {% assign profile_image_class = 'card-img-top img-fluid z-depth-1 rounded mx-auto' %}
                {% endif %}
                {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.25}}px,
                (min-width: 992px) 25vw, (min-width: 768px) 50vw, 95vw"{% endcapture %}
                {%
                  include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes
                  alt=member.profile.image style="max-width:80%; height:auto;"
                %}
              {% endif %}
            </a>
            <div class="card-body text-center">
              {% if member.profile.name %}
                <div class="more-info-name">{{ member.profile.name | split: ',' | first }}</div>
              {% endif %}

              {% if member.team_head and member.profile.role %}
                <div class="more-info-role">{{ member.profile.role }}</div>
              {% elsif member.profile.position %}
                <div class="more-info-role">{{ member.profile.position }}</div>
              {% elsif member.profile.role %}
                <div class="more-info-role">{{ member.profile.role }}</div>
              {% endif %}

              {% if member.profile.keywords %}
                {% assign keywords = member.profile.keywords | sort_natural %}
                <div class="more-info-keywords mt-4 mb-4 flex flex-wrap gap-1">
                  {% for kw in keywords %}
                    <span class="text-xs px-2 py-1 rounded">{{ kw | strip }}</span>
                  {% endfor %}
                </div>
              {% endif %}
              <div class="social-icons border-gray-200 pt-2 border-t gap-3 mt-4">
                {% if member.profile.email %}
                  <a href="mailto:{{ member.profile.email }}" target="_blank" title="Email"> <i class="fas fa-envelope fa-lg"></i></a>
                {% endif %}

                {% if member.profile.linkedin %}
                  <a
                    href="https://www.linkedin.com/in/{{ member.profile.linkedin }}"
                    target="_blank"
                    title="LinkedIn"
                  >
                    <i class="fab fa-linkedin fa-lg"></i
                  ></a>
                {% endif %}
                {% if member.profile.orcid %}
                  <a href="https://orcid.org/{{ member.profile.orcid }}" target="_blank" title="ORCID"> <i class="ai ai-orcid fa-lg"></i></a>
                {% endif %}
                {% if member.profile.googlescholar %}
                  <a href="https://scholar.google.com/citations?user={{ member.profile.googlescholar }}" target="_blank" title="Google Scholar">
                    <i class="ai ai-google-scholar fa-lg"></i
                  ></a>
                {% endif %}
                {% if member.profile.researchgate %}
                  <a
                    href="https://www.researchgate.net/profile/{{ member.profile.researchgate }}"
                    target="_blank"
                    title="ResearchGate"
                  >
                    <i class="fab fa-researchgate fa-lg"></i
                  ></a>
                {% endif %}
                {% if member.profile.scopus %}
                  <a
                    href="https://www.scopus.com/authid/detail.uri?authorId={{ member.profile.scopus }}"
                    target="_blank"
                    title="Scopus"
                  >
                    <i class="fab fa-scopus fa-lg"></i
                  ></a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </p>
{% endfor %}

{% if site.data.alumni.size > 0 %}
  <h2 class="page-section-title">Alumni</h2>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 alumni-list">
    {% for alumnus in site.data.alumni %}
      <div class="col mb-3">
        <div class="alumni-card h-100">
          {% if alumnus.image %}
            <img
              class="alumni-photo"
              src="{{ alumnus.image | prepend: '/assets/img/' | relative_url }}"
              alt="{{ alumnus.name }}"
              loading="lazy"
            >
          {% endif %}
          <div class="alumni-info">
            <div class="alumni-name">
              {% if alumnus.url -%}
                <a href="{{ alumnus.url }}" target="_blank" rel="noopener">{{ alumnus.name }}</a>
              {%- else -%}
                {{ alumnus.name }}
              {%- endif %}
              {% if alumnus.linkedin %}
                {% if alumnus.linkedin contains '://' %}
                  {% assign alumnus_linkedin = alumnus.linkedin %}
                {% else %}
                  {% assign alumnus_linkedin = alumnus.linkedin | prepend: 'https://www.linkedin.com/in/' %}
                {% endif %}
                <a href="{{ alumnus_linkedin }}" target="_blank" rel="noopener" title="LinkedIn"><i class="fab fa-linkedin"></i></a>
              {% endif %}
            </div>
            {% if alumnus.role or alumnus.years %}
              <div class="alumni-role">
                {{- alumnus.role -}}
                {%- if alumnus.role and alumnus.years %} · {% endif -%}
                {{- alumnus.years -}}
              </div>
            {% endif %}
            {% if alumnus.now %}
              <div class="alumni-now"><i class="fa-solid fa-arrow-right"></i> {{ alumnus.now }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
{% endif %}

{% assign head_member = site.members | where: 'team_head', true | first %}
{% assign contact_url = head_member.profile.email | prepend: 'mailto:' %}
{%
  include cta_banner.liquid
  title="Want to join the team?"
  text="PhD positions, research projects and student theses in embedded vision, drones and autonomous systems."
  button="Contact us"
  url=contact_url
%}
