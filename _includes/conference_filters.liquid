<div class="list-filters conference-filters">
  <div class="list-filter-group" data-filter="year">
    <span class="list-filter-label"><i class="fa-regular fa-calendar"></i> Year</span>
    <select class="list-filter-select" aria-label="Filter by year">
      <option value="">All years</option>
    </select>
  </div>
  <div class="list-filter-group" data-filter="type">
    <span class="list-filter-label"><i class="fa-solid fa-person-chalkboard"></i> Type</span>
    <div class="list-filter-chips">
      <button type="button" class="filter-chip active" data-value="">All</button>
    </div>
  </div>
  <div class="list-filter-group" data-filter="conference">
    <span class="list-filter-label"><i class="fa-solid fa-building-columns"></i> Conference</span>
    <select class="list-filter-select" aria-label="Filter by conference">
      <option value="">All conferences</option>
    </select>
  </div>
  <div class="list-filter-footer">
    <span id="conference-filter-count"></span>
    <button type="button" id="conference-filter-reset" class="list-filter-reset" hidden><i class="fa-solid fa-xmark"></i> Clear filters</button>
  </div>
</div>
<p id="conference-filter-empty" class="list-filter-empty" hidden>No conferences match the selected filters.</p>
<script defer src="{{ '/assets/js/conference-filters.js' | relative_url }}"></script>
