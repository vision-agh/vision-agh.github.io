<div
  class="col conf-item"
  data-year="{{ project.start_date | date: '%Y' }}"
  data-type="{{ project.presentation_type }}"
  data-conference="{{ project.name }}"
>
  <div class="card h-100 hoverable">
    {% assign conf_logo = project.img %}
    {% unless conf_logo %}
      {% assign conf_logo_file = site.data.conference_logos[project.name] %}
      {% if conf_logo_file %}{% assign conf_logo = conf_logo_file | prepend: 'assets/img/conferences/' %}{% endif %}
    {% endunless %}
    {% assign conf_logo_exists = 'false' %}
    {% if conf_logo %}
      {% capture conf_logo_exists %}{% file_exists {{ conf_logo }} %}{% endcapture %}
    {% endif %}
    {% if conf_logo_exists == 'true' %}
      <div class="conf-logo">
        <img src="{{ conf_logo | relative_url }}" alt="{{ project.name }} logo" loading="lazy">
      </div>
    {% else %}
      <div class="conf-logo conf-logo-placeholder">
        <span>{{ project.name }}</span>
        {% if project.start_date -%}
          <small>{{ project.start_date | date: '%Y' }}</small>
        {%- endif %}
      </div>
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{{ project.name }}</h2>
      {% if project.topic %}
        <p class="card-text text-center">
          Topic: <span> {{ project.topic }} </span>
        </p>
      {% endif %}

      {% assign split_authors = project.author | split: ', ' %}

      {% if project.author %}
        <p class="card-text text-center">
          <strong>Authors: </strong>
          {% for author in split_authors %}
            {% assign author_lastname = author | split: ' ' | last | remove_accents %}
            <span
              ><a href="/members/{{ author_lastname | downcase }}">{{ author }}</a></span
            >
            {%- unless forloop.last %}, {% endunless %}
          {% endfor %}
        </p>
      {% endif %}

      {% if project.presenter %}
        {% if project.presentation_type == 'poster' %}
          <p class="card-text text-center mb-0"><strong>Poster presented by</strong></p>
        {% elsif project.presentation_type == 'presentation' %}
          <p class="card-text text-center mb-0"><strong>Presented by</strong></p>
        {% elsif project.presentation_type == 'demo' %}
          <p class="card-text text-center mb-0"><strong>Demo presented by</strong></p>
        {% endif %}

        <p class="card-text text-center">
          {% assign split_presenter = project.presenter | split: ', ' %}
          {% for presenter in split_presenter %}
            {% assign author_lastname = presenter | split: ' ' | last | remove_accents %}
            <span
              ><a href="/members/{{ author_lastname | downcase }}">{{ presenter }}</a></span
            >
            {%- unless forloop.last %}, {% endunless %}
          {% endfor %}
        </p>
      {% endif %}

      {% if project.start_date and project.end_date %}
        <p class="card-text text-center">{{ project.start_date | date: '%d %b %Y' }} - {{ project.end_date | date: '%d %b %Y' }}</p>
      {% endif %}

      <div class="social-icons border-gray-200 pt-2 border-t gap-3 mt-4">
        {% if project.arxiv %}
          <a
            href="https://arxiv.org/pdf/{{ project.arxiv }}"
            target="_blank"
            title=""
          >
            <i class="ai ai-arxiv ai-1x"></i>
          </a>
        {% endif %}

        {% if project.journal_link %}
          <a href="{{ project.journal_link }}" target="_blank" title="Link to the journal publication">
            <i class="fa-brands fa-google-drive"></i>
          </a>
        {% endif %}

        {% if project.pdf %}
          <a
            href="/assets/pdf/{{ project.pdf }}"
            target="_blank"
            title="PDF of the presentation"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}

        {% if project.drive %}
          <a
            href="{{ project.drive }}"
            target="_blank"
            title="Google Drive folder with presentation materials"
          >
            <i class="fa-brands fa-google-drive"></i>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>
