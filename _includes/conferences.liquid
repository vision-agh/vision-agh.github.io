<div
  class="col mb-4 conf-item"
  data-year="{{ project.start_date | date: '%Y' }}"
  data-type="{{ project.presentation_type }}"
  data-conference="{{ project.name }}"
  data-scope="{{ project_scope }}"
>
  <div class="card h-100 conf-card">
    {% assign conf_logo = project.img %}
    {% unless conf_logo %}
      {% assign conf_logo_file = site.data.conference_logos[project.name] %}
      {% if conf_logo_file %}{% assign conf_logo = conf_logo_file | prepend: 'assets/img/conferences/' %}{% endif %}
    {% endunless %}
    {% assign conf_logo_exists = 'false' %}
    {% if conf_logo %}
      {% capture conf_logo_exists %}{% file_exists {{ conf_logo }} %}{% endcapture %}
    {% endif %}
    {% if conf_logo_exists == 'true' %}
      <div class="conf-logo{% if project.logo_bg == 'dark' %} conf-logo-dark{% endif %}">
        <img src="{{ conf_logo | relative_url }}" alt="{{ project.name }} logo" loading="lazy">
      </div>
    {% else %}
      <div class="conf-logo conf-logo-placeholder{% if project.logo_bg == 'light' %} conf-logo-placeholder-light{% endif %}">
        <span>{{ project.name }}</span>
        {% if project.start_date -%}
          <small>{{ project.start_date | date: '%Y' }}</small>
        {%- endif %}
      </div>
    {% endif %}

    <div class="card-body">
      <div class="conf-card-head">
        <h2 class="card-title">
          {%- if project.url -%}
            <a href="{{ project.url }}" target="_blank" rel="noopener">
              {{- project.name }}
              {{ project.start_date | date: '%Y' -}}
            </a>
          {%- else -%}
            {{ project.name }}
            {{ project.start_date | date: '%Y' }}
          {%- endif -%}
        </h2>
        <span class="conf-type conf-type-{{ project.presentation_type }}">{{ project.presentation_type }}</span>
      </div>
      {% if project.start_date %}
        <div class="conf-date">
          <i class="fa-regular fa-calendar"></i>
          {% assign start_month = project.start_date | date: '%b %Y' %}
          {% assign end_month = project.end_date | date: '%b %Y' %}
          {% if project.end_date and start_month == end_month -%}
            {{ project.start_date | date: '%-d' }}–{{ project.end_date | date: '%-d %b %Y' }}
          {%- elsif project.end_date -%}
            {{ project.start_date | date: '%-d %b' }} – {{ project.end_date | date: '%-d %b %Y' }}
          {%- else -%}
            {{ project.start_date | date: '%-d %b %Y' }}
          {%- endif %}
        </div>
      {% endif %}

      {% if project.topic %}
        <p class="conf-topic">{{ project.topic }}</p>
      {% endif %}

      {% if project.author %}
        <p class="conf-authors">
          {% assign split_authors = project.author | split: ', ' %}
          {% for author in split_authors %}
            {% assign author_member = site.members | where_exp: 'm', 'm.profile.name == author' | first %}
            {% if author_member -%}
              <a href="{{ author_member.url | relative_url }}">{{ author }}</a>
            {%- else -%}
              {{ author }}
            {%- endif -%}
            {%- unless forloop.last %}, {% endunless %}
          {% endfor %}
        </p>
      {% endif %}
    </div>

    <div class="conf-card-footer">
      <div class="conf-presenters">
        {% if project.presenter %}
          {% assign split_presenter = project.presenter | split: ', ' %}
          <div class="conf-presenter-avatars">
            {% for presenter in split_presenter %}
              {% assign presenter_member = site.members | where_exp: 'm', 'm.profile.name == presenter' | first %}
              {% if presenter_member and presenter_member.profile.image %}
                <a href="{{ presenter_member.url | relative_url }}" title="Presented by {{ presenter }}">
                  <img src="{{ presenter_member.profile.image | prepend: '/assets/img/' | relative_url }}" alt="{{ presenter }}" loading="lazy">
                </a>
              {% else %}
                {% assign initials = '' %}
                {% assign name_parts = presenter | split: ' ' %}
                {% for part in name_parts -%}
                  {%- assign initials = initials | append: part.first -%}
                {%- endfor %}
                <span class="conf-presenter-initials" title="Presented by {{ presenter }}">{{ initials | slice: 0, 2 }}</span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="conf-presenter-label">
            <small>Presented by</small>
            <span>{{ split_presenter | join: ', ' }}</span>
          </div>
        {% endif %}
      </div>
      <div class="conf-links">
        {% if project.journal_link %}
          <a href="{{ project.journal_link }}" target="_blank" rel="noopener" title="Paper">Paper</a>
        {% endif %}
        {% if project.arxiv %}
          <a href="https://arxiv.org/abs/{{ project.arxiv }}" target="_blank" rel="noopener" title="arXiv">arXiv</a>
        {% endif %}
        {% if project.pdf %}
          {% if project.pdf contains '://' %}
            {% assign slides_url = project.pdf %}
          {% else %}
            {% assign slides_url = project.pdf | prepend: '/assets/pdf/' | relative_url %}
          {% endif %}
          <a href="{{ slides_url }}" target="_blank" rel="noopener" title="Slides / poster (PDF)"><i class="fa-solid fa-file-pdf"></i> Slides</a>
        {% endif %}
        {% if project.drive %}
          <a href="{{ project.drive }}" target="_blank" rel="noopener" title="Presentation materials"
            ><i class="fa-brands fa-google-drive"></i> Materials</a
          >
        {% endif %}
      </div>
    </div>
  </div>
</div>
